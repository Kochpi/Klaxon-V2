# Copier ce fichier en ".env" et remplir les valeurs.
# Le fichier .env est ignoré par Git : ne jamais le commiter.

PORT=3000
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP : utilisateur root, mot de passe vide par défaut)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=klaxon_v2

# MongoDB Atlas : chaîne de connexion fournie par Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=klaxon_v2
