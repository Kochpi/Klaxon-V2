# Copier ce fichier en ".env" et remplir les valeurs.
# Le fichier .env est ignoré par Git : ne jamais le commiter.

NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# MySQL (XAMPP : utilisateur root, mot de passe vide par défaut)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=klaxon_v2

# MongoDB : chaîne de connexion (Atlas ou local)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=klaxon_v2

# Secret de signature des jetons de connexion (32 caractères minimum).
# Générer une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
